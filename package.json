{
  "name": "coredrive-rx",
  "version": "1.24.1",
  "private": false,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "description": "Mobile RX coverage capture for CoreScope: BLE companion → MQTT (GPS + SNR/RSSI + multibyte)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efiten/coredrive-rx.git"
  },
  "homepage": "https://github.com/efiten/coredrive-rx#readme",
  "bugs": "https://github.com/efiten/coredrive-rx/issues",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "deploy": "bash deploy.sh",
    "android:sync": "vite build && cap sync android && node -e \"require('fs').rmSync('android/app/src/main/assets/public/config.json',{force:true})\""
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "1.3.1",
    "@capacitor-community/bluetooth-le": "8.3.0",
    "@capacitor-mlkit/barcode-scanning": "8.2.1",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "@noble/ciphers": "2.0.1",
    "@noble/ed25519": "^3.2.0",
    "mqtt": "^5.10.1"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/cli": "8.6.0",
    "vite": "^6.4.5"
  }
}
