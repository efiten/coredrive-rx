<?xml version="1.0" encoding="utf-8"?>
<!-- Replaces the layout of the same name in @capacitor/android (BridgeActivity sets it
     as content view; an app resource wins over a library one). Identical except for the
     WebView class. Compare with the library's copy when upgrading Capacitor. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.getcapacitor.BridgeActivity"
    >

    <eu.on8ar.coredriverx.AlwaysVisibleWebView
        android:id="@+id/webview"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
